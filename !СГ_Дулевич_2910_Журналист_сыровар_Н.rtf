\u1071\'df \u1095\'f7\u1077\'e5\u1083\'eb\u1086\'ee\u1074\'e2\u1077\'e5\u1082\'ea \u1076\'e4\u1086\'ee\u1090\'f2\u1086\'ee\u1096\'f8\u1085\'ed\u1099\'fb\u1081\'e9: \u1077\'e5\u1089\'f1\u1083\'eb\u1080\'e8 \u1079\'e7\u1072\'e0 \u1095\'f7\u1090\'f2\u1086\'ee-\u1090\'f2\u1086\'ee \u1073\'e1\u1077\'e5\u1088\'f0\u1091\'f3\u1089\'f1\u1100\'fc, \u1090\'f2\u1086\'ee \u1087\'ef\u1086\'ee\u1075\'e3\u1088\'f0\u1091\'f3\u1078\'e6\u1072\'e0\u1102\'fe\u1089\'f1\u1100\'fc \u1089\'f1 \u1075\'e3\u1086\'ee\u1083\'eb\u1086\'ee\u1074\'e2\u1086\'ee\u1081\'e9, \u8212\'97 \u1089\'f1\u1084\'ec\u1077\'e5\u1077\'e5\u1090\'f2\u1089\'f1\u1103\'ff \u1093\'f5\u1086\'ee\u1079\'e7\u1103\'ff\u1081\'e9\u1082\'ea\u1072\'e0. \u8212\'97 \u1055\'cf\u1088\'f0\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee \u1082\'ea\u1091\'f3\u1087\'ef\u1080\'e8\u1090\'f2\u1100\'fc \u1082\'ea\u1086\'ee\u1079\'e7\u1091\'f3 \u1085\'ed\u1072\'e0 \u1088\'f0\u1099\'fb\u1085\'ed\u1082\'ea\u1077\'e5 \u8212\'97 \u1085\'ed\u1077\'e5 \u1084\'ec\u1086\'ee\u1081\'e9 \u1074\'e2\u1072\'e0\u1088\'f0\u1080\'e8\u1072\'e0\u1085\'ed\u1090\'f2. \u1071\'df \u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1088\'f0\u1099\'fb\u1083\'eb\u1072\'e0 \u1075\'e3\u1086\'ee\u1088\'f0\u1099\'fb \u1082\'ea\u1085\'ed\u1080\'e8\u1075\'e3, \u1080\'e8\u1079\'e7\u1091\'f3\u1095\'f7\u1080\'e8\u1083\'eb\u1072\'e0 \u1074\'e2\u1089\'f1\u1077\'e5 \u1087\'ef\u1086\'ee\u1088\'f0\u1086\'ee\u1076\'e4\u1099\'fb \u1080\'e8 \u1086\'ee\u1089\'f1\u1086\'ee\u1073\'e1\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1080\'e8 \u1091\'f3\u1093\'f5\u1086\'ee\u1076\'e4\u1072\'e0.}
