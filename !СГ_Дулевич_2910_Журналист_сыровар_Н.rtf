\u1042\'c2 \u1086\'ee\u1076\'e4\u1080\'e8\u1085\'ed \u1076\'e4\u1077\'e5\u1085\'ed\u1100\'fc \u1074\'e2\u1076\'e4\u1088\'f0\u1091\'f3\u1075\'e3 \u1087\'ef\u1086\'ee\u1085\'ed\u1103\'ff\u1083\'eb\u1072\'e0, \u1095\'f7\u1090\'f2\u1086\'ee \u1091\'f3\u1089\'f1\u1090\'f2\u1072\'e0\u1083\'eb\u1072\'e0 \u1086\'ee\u1090\'f2 \u1075\'e3\u1086\'ee\u1088\'f0\u1086\'ee\u1076\'e4\u1072\'e0. \u1042\'c2\u1088\'f0\u1086\'ee\u1076\'e4\u1077\'e5 \u1074\'e2\u1089\'f1\u1077\'e5 \u1073\'e1\u1099\'fb\u1083\'eb\u1086\'ee \u1093\'f5\u1086\'ee\u1088\'f0\u1086\'ee\u1096\'f8\u1086\'ee: \u1080\'e8 \u1082\'ea\u1072\'e0\u1088\'f0\u1100\'fc\u1077\'e5\u1088\'f0\u1072\'e0, \u1080\'e8 \u1089\'f1\u1077\'e5\u1084\'ec\u1100\'fc\u1103\'ff, \u1080\'e8 \u1089\'f1\u1074\'e2\u1086\'ee\u1103\'ff \u1082\'ea\u1074\'e2\u1072\'e0\u1088\'f0\u1090\'f2\u1080\'e8\u1088\'f0\u1072\'e0. \u1063\'d7\u1077\'e5\u1075\'e3\u1086\'ee-\u1090\'f2\u1086\'ee \u1076\'e4\u1083\'eb\u1103\'ff \u1089\'f1\u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1100\'fc\u1103\'ff \u1085\'ed\u1077\'e5 \u1093\'f5\u1074\'e2\u1072\'e0\u1090\'f2\u1072\'e0\u1083\'eb\u1086\'ee. \u1042\'c2\u1085\'ed\u1091\'f3\u1090\'f2\u1088\'f0\u1080\'e8 \u1073\'e1\u1091\'f3\u1076\'e4\u1090\'f2\u1086\'ee \u1090\'f2\u1091\'f3\u1084\'ec\u1073\'e1\u1083\'eb\u1077\'e5\u1088\'f0 \u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1082\'ea\u1083\'eb\u1102\'fe\u1095\'f7\u1080\'e8\u1083\'eb\u1089\'f1\u1103\'ff, \u1080\'e8 \u1103\'ff \u1091\'f3\u1074\'e2\u1086\'ee\u1083\'eb\u1080\'e8\u1083\'eb\u1072\'e0\u1089\'f1\u1100\'fc. \u1052\'cc\u1099\'fb \u1089\'f1 \u1084\'ec\u1091\'f3\u1078\'e6\u1077\'e5\u1084\'ec \u1089\'f1\u1086\'ee\u1073\'e1\u1088\'f0\u1072\'e0\u1083\'eb\u1080\'e8 \u1074\'e2\u1077\'e5\u1097\'f9\u1080\'e8, \u1086\'ee\u1089\'f1\u1090\'f2\u1072\'e0\u1074\'e2\u1080\'e8\u1083\'eb\u1080\'e8 \u1078\'e6\u1080\'e8\u1083\'eb\u1100\'fc\u1077\'e5 \u1076\'e4\u1077\'e5\u1090\'f2\u1103\'ff\u1084\'ec \u1080\'e8 \u1091\'f3\u1077\'e5\u1093\'f5\u1072\'e0\u1083\'eb\u1080\'e8 \u1074\'e2 \u1076\'e4\u1077\'e5\u1088\'f0\u1077\'e5\u1074\'e2\u1085\'ed\u1102\'fe. \u1048\'c8 \u1090\'f2\u1086\'ee\u1083\'eb\u1100\'fc\u1082\'ea\u1086\'ee \u1079\'e7\u1076\'e4\u1077\'e5\u1089\'f1\u1100\'fc \u1087\'ef\u1086\'ee\u1095\'f7\u1091\'f3\u1074\'e2\u1089\'f1\u1090\'f2\u1074\'e2\u1086\'ee\u1074\'e2\u1072\'e0\u1083\'eb\u1072\'e0 \u1089\'f1\u1077\'e5\u1073\'e1\u1103\'ff \u1087\'ef\u1086\'ee-\u1085\'ed\u1072\'e0\u1089\'f1\u1090\'f2\u1086\'ee\u1103\'ff\u1097\'f9\u1077\'e5\u1084\'ec\u1091\'f3 \u1089\'f1\u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1083\'eb\u1080\'e8\u1074\'e2\u1086\'ee\u1081\'e9.}
