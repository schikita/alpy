\u1042\'c2\u1089\'f1\u1077\'e5 \u1078\'e6\u1080\'e8\u1074\'e2\u1086\'ee\u1090\'f2\u1085\'ed\u1099\'fb\u1077\'e5 \u1079\'e7\u1076\'e4\u1077\'e5\u1089\'f1\u1100\'fc \u1085\'ed\u1072\'e0 \u1089\'f1\u1090\'f2\u1088\'f0\u1086\'ee\u1075\'e3\u1086\'ee\u1084\'ec \u1074\'e2\u1077\'e5\u1090\'f2\u1077\'e5\u1088\'f0\u1080\'e8\u1085\'ed\u1072\'e0\u1088\'f0\u1085\'ed\u1086\'ee\u1084\'ec \u1091\'f3\u1095\'f7\u1077\'e5\u1090\'f2\u1077\'e5, \u1072\'e0 \u1091\'f3\u1089\'f1\u1083\'eb\u1086\'ee\u1074\'e2\u1080\'e8\u1103\'ff \u1091\'f3 \u1085\'ed\u1080\'e8\u1093\'f5 \u8212\'97 \u1082\'ea\u1072\'e0\u1082\'ea \u1074\'e2 \u1082\'ea\u1086\'ee\u1079\'e7\u1100\'fc\u1077\'e5\u1084\'ec \u1089\'f1\u1072\'e0\u1085\'ed\u1072\'e0\u1090\'f2\u1086\'ee\u1088\'f0\u1080\'e8\u1080\'e8. \u1048\'c8 \u1078\'e6\u1080\'e8\u1074\'e2\u1086\'ee\u1090\'f2\u1085\'ed\u1099\'fb\u1077\'e5 \u1087\'ef\u1083\'eb\u1072\'e0\u1090\'f2\u1103\'ff\u1090\'f2 \u1079\'e7\u1072\'e0 \u1101\'fd\u1090\'f2\u1086\'ee \u1074\'e2\u1079\'e7\u1072\'e0\u1080\'e8\u1084\'ec\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1100\'fc\u1102\'fe: \u1093\'f5\u1086\'ee\u1076\'e4\u1103\'ff\u1090\'f2 \u1079\'e7\u1072\'e0 \u1048\'c8\u1088\'f0\u1080\'e8\u1085\'ed\u1086\'ee\u1081\'e9 \u1087\'ef\u1086\'ee \u1087\'ef\u1103\'ff\u1090\'f2\u1072\'e0\u1084\'ec \u1080\'e8 \u1089\'f1\u1083\'eb\u1091\'f3\u1096\'f8\u1072\'e0\u1102\'fe\u1090\'f2\u1089\'f1\u1103\'ff \u1085\'ed\u1077\'e5 \u1093\'f5\u1091\'f3\u1078\'e6\u1077\'e5 \u1076\'e4\u1088\'f0\u1077\'e5\u1089\'f1\u1089\'f1\u1080\'e8\u1088\'f0\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1085\'ed\u1099\'fb\u1093\'f5 \u1089\'f1\u1086\'ee\u1073\'e1\u1072\'e0\u1082\'ea.}
