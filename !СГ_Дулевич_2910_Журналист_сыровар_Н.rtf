\u8212\'97 }{\rtlch\af13 \ltrch\hich\af5\loch\f5\loch
\u1050\'ca\u1086\'ee\u1079\'e7\u1099\'fb \u8212\'97 \u1078\'e6\u1080\'e8\u1074\'e2\u1086\'ee\u1090\'f2\u1085\'ed\u1099\'fb\u1077\'e5 \u1086\'ee\u1095\'f7\u1077\'e5\u1085\'ed\u1100\'fc \u1091\'f3\u1084\'ec\u1085\'ed\u1099\'fb\u1077\'e5 \u1080\'e8 \u1095\'f7\u1091\'f3\u1090\'f2\u1082\'ea\u1080\'e8\u1077\'e5, \u8212\'97 \u1086\'ee\u1073\'e1\u1098\'fa\u1103\'ff\u1089\'f1\u1085\'ed\u1103\'ff\u1077\'e5\u1090\'f2 \u1093\'f5\u1086\'ee\u1079\'e7\u1103\'ff\u1081\'e9\u1082\'ea\u1072\'e0. \u8212\'97 \u1048\'c8\u1093\'f5 \u1087\'ef\u1080\'e8\u1097\'f9\u1077\'e5\u1074\'e2\u1072\'e0\u1088\'f0\u1080\'e8\u1090\'f2\u1077\'e5\u1083\'eb\u1100\'fc\u1085\'ed\u1072\'e0\u1103\'ff \u1089\'f1\u1080\'e8\u1089\'f1\u1090\'f2\u1077\'e5\u1084\'ec\u1072\'e0 \u1080\'e8\u1079\'e7 \u1095\'f7\u1077\'e5\u1090\'f2\u1099\'fb\u1088\'f0\u1077\'e5\u1093\'f5 \u1078\'e6\u1077\'e5\u1083\'eb\u1091\'f3\u1076\'e4\u1082\'ea\u1086\'ee\u1074\'e2 \u1088\'f0\u1072\'e0\u1073\'e1\u1086\'ee\u1090\'f2\u1072\'e0\u1077\'e5\u1090\'f2 \u1082\'ea\u1072\'e0\u1082\'ea \u1089\'f1\u1083\'eb\u1086\'ee\u1078\'e6\u1085\'ed\u1099\'fb\u1081\'e9 \u1088\'f0\u1077\'e5\u1072\'e0\u1082\'ea\u1090\'f2\u1086\'ee\u1088\'f0, \u1090\'f2\u1091\'f3\u1076\'e4\u1072\'e0 \u1085\'ed\u1077\'e5\u1083\'eb\u1100\'fc\u1079\'e7\u1103\'ff \u1073\'e1\u1088\'f0\u1086\'ee\u1089\'f1\u1072\'e0\u1090\'f2\u1100\'fc \u1087\'ef\u1083\'eb\u1086\'ee\u1093\'f5\u1086\'ee\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1084\'ec. \u1053\'cd\u1086\'ee \u1077\'e5\u1097\'f9\u1077\'e5 \u1074\'e2\u1072\'e0\u1078\'e6\u1085\'ed\u1077\'e5\u1077\'e5 \u1076\'e4\u1083\'eb\u1103\'ff \u1085\'ed\u1080\'e8\u1093\'f5 \u8212\'97 \u1083\'eb\u1072\'e0\u1089\'f1\u1082\'ea\u1072\'e0. \u1042\'c2 \u1086\'ee\u1090\'f2\u1083\'eb\u1080\'e8\u1095\'f7\u1080\'e8\u1077\'e5 \u1086\'ee\u1090\'f2 \u1082\'ea\u1086\'ee\u1088\'f0\u1086\'ee\u1074\'e2 \u1082\'ea\u1086\'ee\u1079\'e7\u1072\'e0\u1084\'ec \u1078\'e6\u1080\'e8\u1079\'e7\u1085\'ed\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee \u1085\'ed\u1077\'e5\u1086\'ee\u1073\'e1\u1093\'f5\u1086\'ee\u1076\'e4\u1080\'e8\u1084\'ec\u1099\'fb \u1083\'eb\u1102\'fe\u1073\'e1\u1086\'ee\u1074\'e2\u1100\'fc \u1080\'e8 \u1074\'e2\u1085\'ed\u1080\'e8\u1084\'ec\u1072\'e0\u1085\'ed\u1080\'e8\u1077\'e5. \u1050\'ca\u1086\'ee\u1075\'e3\u1076\'e4\u1072\'e0 \u1086\'ee\u1085\'ed\u1080\'e8 \u1074\'e2 \u1082\'ea\u1086\'ee\u1084\'ec\u1092\'f4\u1086\'ee\u1088\'f0\u1090\'f2\u1077\'e5 \u1080\'e8 \u1073\'e1\u1077\'e5\u1079\'e7\u1086\'ee\u1087\'ef\u1072\'e0\u1089\'f1\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1080\'e8, \u1090\'f2\u1086\'ee \u1080\'e8 \u1084\'ec\u1086\'ee\u1083\'eb\u1086\'ee\u1082\'ea\u1086\'ee \u1076\'e4\u1072\'e0\u1102\'fe\u1090\'f2 \u1080\'e8\u1076\'e4\u1077\'e5\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1086\'ee\u1077\'e5, \u1073\'e1\u1077\'e5\u1079\'e7 \u1074\'e2\u1089\'f1\u1103\'ff\u1082\'ea\u1086\'ee\u1075\'e3\u1086\'ee \u1089\'f1\u1087\'ef\u1077\'e5\u1094\'f6\u1080\'e8\u1092\'f4\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1086\'ee\u1075\'e3\u1086\'ee \u1079\'e7\u1072\'e0\u1087\'ef\u1072\'e0\u1093\'f5\u1072\'e0. \u1058\'d2\u1072\'e0\u1082\'ea \u1095\'f7\u1090\'f2\u1086\'ee \u1083\'eb\u1102\'fe\u1073\'e1\u1086\'ee\u1074\'e2\u1100\'fc \u8212\'97 \u1086\'ee\u1073\'e1\u1103\'ff\u1079\'e7\u1072\'e0\u1090\'f2\u1077\'e5\u1083\'eb\u1100\'fc\u1085\'ed\u1099\'fb\u1081\'e9 \u1080\'e8\u1085\'ed\u1075\'e3\u1088\'f0\u1077\'e5\u1076\'e4\u1080\'e8\u1077\'e5\u1085\'ed\u1090\'f2 \u1074\'e2 \u1085\'ed\u1072\'e0\u1096\'f8\u1077\'e5\u1084\'ec \u1088\'f0\u1077\'e5\u1094\'f6\u1077\'e5\u1087\'ef\u1090\'f2\u1077\'e5.}
