\par \pard\plain \s125\rtlch\af10\afs22\alang1025 \ltrch\lang1049\langfe2052\hich\af6\loch\ql\widctlpar\hyphpar0\faauto\ltrpar\cf0\f6\fs22\lang1049\kerning1\dbch\af11\langfe2052\sl276\slmult1\qj\li0\ri0\lin0\rin0\fi720{\rtlch\af13\ab \ltrch\hich\af5\loch\b\f5\loch
\u1042\'c2\u1099\'fb \u1082\'ea\u1086\'ee\u1075\'e3\u1076\'e4\u1072\'e0-\u1085\'ed\u1080\'e8\u1073\'e1\u1091\'f3\u1076\'e4\u1100\'fc \u1076\'e4\u1091\'f3\u1084\'ec\u1072\'e0\u1083\'eb\u1080\'e8 \u1073\'e1\u1088\'f0\u1086\'ee\u1089\'f1\u1080\'e8\u1090\'f2\u1100\'fc \u1074\'e2\u1089\'f1\u1077\'e5 \u1080\'e8 \u1089\'f1\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8\u1090\'f2\u1100\'fc \u1087\'ef\u1088\'f0\u1086\'ee\u1092\'f4\u1077\'e5\u1089\'f1\u1089\'f1\u1080\'e8\u1102\'fe? \u1053\'cd\u1072\'e0\u1087\'ef\u1088\'f0\u1080\'e8\u1084\'ec\u1077\'e5\u1088\'f0, \u1091\'f3\u1077\'e5\u1093\'f5\u1072\'e0\u1090\'f2\u1100\'fc \u1074\'e2 \u1075\'e3\u1083\'eb\u1091\'f3\u1096\'f8\u1100\'fc \u1080\'e8 \u1079\'e7\u1072\'e0\u1085\'ed\u1103\'ff\u1090\'f2\u1100\'fc\u1089\'f1\u1103\'ff \u1082\'ea\u1088\'f0\u1072\'e0\u1092\'f4\u1090\'f2\u1086\'ee\u1074\'e2\u1099\'fb\u1084\'ec \u1089\'f1\u1099\'fb\u1088\'f0\u1086\'ee\u1076\'e4\u1077\'e5\u1083\'eb\u1080\'e8\u1077\'e5\u1084\'ec? \u1071\'df, \u1078\'e6\u1091\'f3\u1088\'f0\u1085\'ed\u1072\'e0\u1083\'eb\u1080\'e8\u1089\'f1\u1090\'f2 \u171\'ab\u1057\'d1\u1043\'c3\u187\'bb \u1045\'c5\u1075\'e3\u1086\'ee\u1088\'f0 \u1044\'c4\u1091\'f3\u1083\'eb\u1077\'e5\u1074\'e2\u1080\'e8\u1095\'f7,  \u1086\'ee\u1090\'f2\u1095\'f7\u1072\'e0\u1103\'ff\u1085\'ed\u1085\'ed\u1086\'ee \u1088\'f0\u1080\'e8\u1089\'f1\u1082\'ea\u1085\'ed\u1091\'f3\u1083\'eb \u1101\'fd\u1090\'f2\u1086\'ee \u1089\'f1\u1076\'e4\u1077\'e5\u1083\'eb\u1072\'e0\u1090\'f2\u1100\'fc. \u1055\'cf\u1088\'f0\u1072\'e0\u1074\'e2\u1076\'e4\u1072\'e0, \u1074\'e2\u1089\'f1\u1077\'e5\u1075\'e3\u1086\'ee \u1085\'ed\u1072\'e0 \u1086\'ee\u1076\'e4\u1080\'e8\u1085\'ed \u1076\'e4\u1077\'e5\u1085\'ed\u1100\'fc. \u1053\'cd\u1086\'ee \u1101\'fd\u1090\'f2\u1086\'ee\u1075\'e3\u1086\'ee \u1074\'e2\u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8 \u1093\'f5\u1074\'e2\u1072\'e0\u1090\'f2\u1080\'e8\u1083\'eb\u1086\'ee, \u1095\'f7\u1090\'f2\u1086\'ee\u1073\'e1\u1099\'fb \u1087\'ef\u1086\'ee\u1085\'ed\u1103\'ff\u1090\'f2\u1100\'fc: \u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1089\'f1\u1083\'eb\u1086\'ee \u1089\'f1\u1099\'fb\u1088\'f0\u1086\'ee\u1074\'e2\u1072\'e0\u1088\'f0\u1072\'e0 \u8212\'97 \u1079\'e7\u1072\'e0\u1093\'f5\u1074\'e2\u1072\'e0\u1090\'f2\u1099\'fb\u1074\'e2\u1072\'e0\u1102\'fe\u1097\'f9\u1080\'e8\u1081\'e9, \u1085\'ed\u1086\'ee \u1090\'f2\u1088\'f0\u1091\'f3\u1076\'e4\u1086\'ee\u1077\'e5\u1084\'ec\u1082\'ea\u1080\'e8\u1081\'e9 \u1087\'ef\u1088\'f0\u1086\'ee\u1094\'f6\u1077\'e5\u1089\'f1\u1089\'f1. \u1057\'d1\u1087\'ef\u1086\'ee\u1081\'e9\u1083\'eb\u1077\'e5\u1088\'f0: \u1075\'e3\u1091\'f3\u1084\'ec\u1072\'e0\u1085\'ed\u1080\'e8\u1090\'f2\u1072\'e0\u1088\'f0\u1080\'e8\u1103\'ff\u1084\'ec, \u1082\'ea\u1072\'e0\u1082\'ea \u1103\'ff, \u1090\'f2\u1086\'ee\u1095\'f7\u1085\'ed\u1086\'ee \u1073\'e1\u1091\'f3\u1076\'e4\u1077\'e5\u1090\'f2 \u1089\'f1\u1083\'eb\u1086\'ee\u1078\'e6\u1085\'ed\u1086\'ee. \u1061\'d5\u1086\'ee\u1090\'f2\u1103\'ff \u1080\'e8 \u1085\'ed\u1077\'e5 \u1089\'f1\u1090\'f2\u1086\'ee\u1080\'e8\u1090\'f2, \u1085\'ed\u1072\'e0\u1074\'e2\u1077\'e5\u1088\'f0\u1085\'ed\u1086\'ee\u1077\'e5, \u1086\'ee\u1073\'e1\u1086\'ee\u1073\'e1\u1097\'f9\u1072\'e0\u1090\'f2\u1100\'fc. \u1053\'cd\u1072\'e0 \u1089\'f1\u1083\'eb\u1086\'ee\u1074\'e2\u1086\'ee \u1074\'e2\u1099\'fb \u1084\'ec\u1085\'ed\u1077\'e5 \u1074\'e2\u1088\'f0\u1103\'ff\u1076\'e4 \u1083\'eb\u1080\'e8 \u1087\'ef\u1086\'ee\u1074\'e2\u1077\'e5\u1088\'f0\u1080\'e8\u1090\'f2\u1077\'e5, \u1087\'ef\u1086\'ee\u1101\'fd\u1090\'f2\u1086\'ee\u1084\'ec\u1091\'f3 \u1087\'ef\u1088\'f0\u1080\'e8\u1075\'e3\u1086\'ee\u1090\'f2\u1086\'ee\u1074\'e2\u1100\'fc\u1090\'f2\u1077\'e5\u1089\'f1\u1100\'fc \u1082\'ea \u1095\'f7\u1077\'e5\u1089\'f1\u1090\'f2\u1085\'ed\u1086\'ee\u1084\'ec\u1091\'f3 \u1088\'f0\u1077\'e5\u1087\'ef\u1086\'ee\u1088\'f0\u1090\'f2\u1072\'e0\u1078\'e6\u1091\'f3 \u1086\'ee \u1090\'f2\u1086\'ee\u1084\'ec, \u1082\'ea\u1072\'e0\u1082\'ea \u1103\'ff \u1074\'e2\u1084\'ec\u1077\'e5\u1089\'f1\u1090\'f2\u1077\'e5 \u1089\'f1 \u1082\'ea\u1086\'ee\u1083\'eb\u1083\'eb\u1077\'e5\u1075\'e3\u1086\'ee\u1081\'e9-\u1092\'f4\u1086\'ee\u1090\'f2\u1086\'ee\u1075\'e3\u1088\'f0\u1072\'e0\u1092\'f4\u1086\'ee\u1084\'ec \u1050\'ca\u1088\'f0\u1080\'e8\u1089\'f1\u1090\'f2\u1080\'e8\u1085\'ed\u1086\'ee\u1081\'e9 \u1060\'d4\u1072\'e0\u1085\'ed\u1095\'f7\u1077\'e5\u1085\'ed\u1082\'ea\u1086\'ee \u1087\'ef\u1099\'fb\u1090\'f2\u1072\'e0\u1083\'eb\u1089\'f1\u1103\'ff \u1082\'ea\u1088\'f0\u1091\'f3\u1090\'f2\u1080\'e8\u1090\'f2\u1100\'fc \u1089\'f1\u1099\'fb\u1088\'f0\u1085\'ed\u1099\'fb\u1077\'e5 \u1075\'e3\u1086\'ee\u1083\'eb\u1086\'ee\u1074\'e2\u1099\'fb. \u1040\'c0 \u1077\'e5\u1097\'f9\u1077\'e5 \u1084\'ec\u1099\'fb \u1084\'ec\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1083\'eb\u1102\'fe\u1073\'e1\u1086\'ee\u1087\'ef\u1099\'fb\u1090\'f2\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1091\'f3\u1079\'e7\u1085\'ed\u1072\'e0\u1083\'eb\u1080\'e8 \u1087\'ef\u1088\'f0\u1086\'ee \u1082\'ea\u1086\'ee\u1079\'e7. \u1053\'cd\u1072\'e0\u1087\'ef\u1088\'f0\u1080\'e8\u1084\'ec\u1077\'e5\u1088\'f0, \u1087\'ef\u1086\'ee\u1095\'f7\u1077\'e5\u1084\'ec\u1091\'f3 \u1082\'ea\u1086\'ee\u1079\'e7\u1100\'fc\u1080\'e8 \u1078\'e6\u1077\'e5\u1083\'eb\u1091\'f3\u1076\'e4\u1082\'ea\u1080\'e8 \u1088\'f0\u1072\'e0\u1073\'e1\u1086\'ee\u1090\'f2\u1072\'e0\u1102\'fe\u1090\'f2 \u1082\'ea\u1072\'e0\u1082\'ea \u1103\'ff\u1076\'e4\u1077\'e5\u1088\'f0\u1085\'ed\u1099\'fb\u1081\'e9 \u1088\'f0\u1077\'e5\u1072\'e0\u1082\'ea\u1090\'f2\u1086\'ee\u1088\'f0? \u1042\'c2 \u1086\'ee\u1073\'e1\u1097\'f9\u1077\'e5\u1084\'ec, \u1085\'ed\u1072\'e0\u1084\'ec \u1073\'e1\u1099\'fb\u1083\'eb\u1086\'ee \u1080\'e8\u1085\'ed\u1090\'f2\u1077\'e5\u1088\'f0\u1077\'e5\u1089\'f1\u1085\'ed\u1086\'ee. \u1060\'d4\u1077\'e5\u1088\'f0\u1084\'ec\u1077\'e5\u1088\'f0\u1086\'ee\u1074\'e2 \u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1080\'e8\u1084\'ec \u1085\'ed\u1077\'e5 \u1089\'f1\u1091\'f3\u1076\'e4\u1080\'e8\u1090\'f2\u1100\'fc \u1089\'f1\u1090\'f2\u1088\'f0\u1086\'ee\u1075\'e3\u1086\'ee, \u1072\'e0 \u1091\'f3\u1088\'f0\u1073\'e1\u1072\'e0\u1085\'ed\u1080\'e8\u1089\'f1\u1090\'f2\u1072\'e0\u1084\'ec, \u1076\'e4\u1091\'f3\u1084\'ec\u1072\'e0\u1102\'fe, \u1073\'e1\u1091\'f3\u1076\'e4\u1077\'e5\u1090\'f2 \u1087\'ef\u1086\'ee\u1079\'e7\u1085\'ed\u1072\'e0\u1074\'e2\u1072\'e0\u1090\'f2\u1077\'e5\u1083\'eb\u1100\'fc\u1085\'ed\u1086\'ee \u1091\'f3\u1079\'e7\u1085\'ed\u1072\'e0\u1090\'f2\u1100\'fc \u1086\'ee \u1088\'f0\u1077\'e5\u1072\'e0\u1083\'eb\u1080\'e8\u1103\'ff\u1093\'f5 \u1089\'f1\u1077\'e5\u1083\'eb\u1100\'fc\u1089\'f1\u1082\'ea\u1086\'ee\u1081\'e9 \u1078\'e6\u1080\'e8\u1079\'e7\u1085\'ed\u1080\'e8, \u1074\'e2 \u1082\'ea\u1086\'ee\u1090\'f2\u1086\'ee\u1088\'f0\u1099\'fb\u1093\'f5 \u1090\'f2\u1088\'f0\u1091\'f3\u1076\'e4\u1086\'ee\u1083\'eb\u1102\'fe\u1073\'e1\u1080\'e8\u1074\'e2\u1099\'fb\u1077\'e5 \u1080\'e8 \u1090\'f2\u1072\'e0\u1083\'eb\u1072\'e0\u1085\'ed\u1090\'f2\u1083\'eb\u1080\'e8\u1074\'e2\u1099\'fb\u1077\'e5 \u1083\'eb\u1102\'fe\u1076\'e4\u1080\'e8 \u1087\'ef\u1088\'f0\u1086\'ee\u1080\'e8\u1079\'e7\u1074\'e2\u1086\'ee\u1076\'e4\u1103\'ff\u1090\'f2 \u1091\'f3\u1085\'ed\u1080\'e8\u1082\'ea\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1099\'fb\u1081\'e9 \u1087\'ef\u1088\'f0\u1086\'ee\u1076\'e4\u1091\'f3\u1082\'ea\u1090\'f2, \u1076\'e4\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee\u1081\'e9\u1085\'ed\u1099\'fb\u1081\'e9 \u1084\'ec\u1080\'e8\u1096\'f8\u1083\'eb\u1077\'e5\u1085\'ed\u1086\'ee\u1074\'e2\u1089\'f1\u1082\'ea\u1080\'e8\u1093\'f5 \u1088\'f0\u1077\'e5\u1089\'f1\u1090\'f2\u1086\'ee\u1088\'f0\u1072\'e0\u1085\'ed\u1086\'ee\u1074\'e2. \u1047\'c7\u1072\'e0\u1080\'e8\u1085\'ed\u1090\'f2\u1088\'f0\u1080\'e8\u1075\'e3\u1086\'ee\u1074\'e2\u1072\'e0\u1083\'eb\u1080\'e8? \u1058\'d2\u1086\'ee\u1075\'e3\u1076\'e4\u1072\'e0 \u1074\'e2 \u1087\'ef\u1091\'f3\u1090\'f2\u1100\'fc!}
